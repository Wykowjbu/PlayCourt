@page
@model PlayCourt.Pages.Matches.IndexModel
@{
    Layout = "_MatchesLayout";
    ViewData["Title"] = "Join a Match";
}

<main class="max-w-[1280px] mx-auto pb-24">
    <section class="px-6 pt-12 pb-8">
        <div class="flex flex-col gap-4 mb-10">
            <h1 class="text-4xl font-black tracking-tight text-slate-900 dark:text-white">Join a Match in Da Nang</h1>
            <p class="text-lg text-slate-500 dark:text-slate-400 font-medium max-w-2xl">Connect with players of your skill level and hit the court today. No partner? No problem.</p>
        </div>

        <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 mb-12">
            <form method="get" class="flex flex-col md:flex-row gap-4">
                <div class="flex-1 flex items-center gap-3 px-4 py-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-transparent focus-within:border-primary/50 transition-all">
                    <span class="material-symbols-outlined text-primary">sports_tennis</span>
                    <div class="flex flex-col w-full">
                        <label class="text-[10px] font-black uppercase text-slate-400 leading-none mb-1">Sport</label>
                        <select asp-for="ViewModel.SelectedSport" asp-items="@(new SelectList(Model.ViewModel.Sports))" class="bg-transparent border-none p-0 focus:ring-0 text-sm font-bold w-full text-slate-800 dark:text-slate-200">
                        </select>
                    </div>
                </div>

                <div class="flex-1 flex items-center gap-3 px-4 py-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-transparent focus-within:border-primary/50 transition-all">
                    <span class="material-symbols-outlined text-primary">leaderboard</span>
                    <div class="flex flex-col w-full">
                        <label class="text-[10px] font-black uppercase text-slate-400 leading-none mb-1">Skill Level</label>
                        <select asp-for="ViewModel.SelectedLevel" asp-items="@(new SelectList(Model.ViewModel.Levels))" class="bg-transparent border-none p-0 focus:ring-0 text-sm font-bold w-full text-slate-800 dark:text-slate-200">
                        </select>
                    </div>
                </div>

                <div class="flex-1 flex items-center gap-3 px-4 py-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-transparent focus-within:border-primary/50 transition-all">
                    <span class="material-symbols-outlined text-primary">distance</span>
                    <div class="flex flex-col w-full">
                        <label class="text-[10px] font-black uppercase text-slate-400 leading-none mb-1">Distance</label>
                        <select asp-for="ViewModel.SelectedDistance" asp-items="@(new SelectList(Model.ViewModel.Distances))" class="bg-transparent border-none p-0 focus:ring-0 text-sm font-bold w-full text-slate-800 dark:text-slate-200">
                        </select>
                    </div>
                </div>

                <button type="submit" class="bg-primary text-white font-black px-10 py-4 rounded-xl flex items-center justify-center gap-2 hover:brightness-110 transition-all shadow-lg shadow-primary/30">
                    <span class="material-symbols-outlined">filter_list</span>
                    <span>Search Matches</span>
                </button>
            </form>
        </div>

        <div class="flex flex-col gap-8">
            <div class="flex items-center justify-between">
                <h2 class="text-2xl font-black text-slate-900 dark:text-white flex items-center gap-3">
                    Live Match Feed
                    <span class="inline-flex h-2 w-2 rounded-full bg-red-500 animate-pulse"></span>
                </h2>
                <div class="flex items-center gap-2 text-sm font-bold text-slate-500">
                    <span>Sort by:</span>
                    <button class="text-primary flex items-center gap-1">Soonest <span class="material-symbols-outlined text-sm">expand_more</span></button>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var match in Model.ViewModel.LiveMatches)
                {
                    <div class="group bg-white dark:bg-slate-800 rounded-[2rem] overflow-hidden border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-2xl transition-all flex flex-col">
                        <div class="relative h-48 w-full overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"></div>
                            <div class="absolute top-4 left-4 z-20 @match.SportBadgeColor text-white text-[10px] font-black px-3 py-1 rounded-full uppercase">@match.SportType</div>
                            <div class="absolute bottom-4 left-4 z-20 text-white">
                                <p class="text-sm font-bold flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">location_on</span> @match.VenueName
                                </p>
                            </div>
                            <div class="w-full h-full bg-center bg-cover group-hover:scale-110 transition-transform duration-700" style='background-image: url("@match.ImageUrl");'></div>
                        </div>

                        <div class="p-6 flex flex-col flex-1">
                            <div class="flex justify-between items-start mb-6">
                                <div>
                                    <h3 class="text-xl font-black text-slate-900 dark:text-white">@match.Title</h3>
                                    <p class="text-sm font-bold text-slate-400 mt-1 flex items-center gap-2">
                                        <span class="material-symbols-outlined text-sm">schedule</span> @match.StartTimeText
                                    </p>
                                </div>
                                <div class="@match.LevelBadgeClass px-3 py-1 rounded-lg text-xs font-black uppercase">
                                    @match.SkillLevel
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-4 mb-8">
                                <div class="bg-slate-50 dark:bg-slate-900/50 p-3 rounded-xl border border-slate-100 dark:border-slate-700">
                                    <p class="text-[10px] font-black text-slate-400 uppercase mb-1">Cost / Person</p>
                                    <p class="text-lg font-black text-primary">$@match.PricePerPerson</p>
                                </div>
                                <div class="bg-slate-50 dark:bg-slate-900/50 p-3 rounded-xl border border-slate-100 dark:border-slate-700">
                                    <p class="text-[10px] font-black text-slate-400 uppercase mb-1">Availability</p>
                                    <p class="text-lg font-black @(match.SpotsLeft == 1 ? "text-rose-500" : match.SpotsLeft <= 2 ? "text-blue-500" : "text-primary")">
                                        @match.SpotsLeft spot@(match.SpotsLeft > 1 ? "s" : "") left
                                    </p>
                                </div>
                            </div>

                            <div class="mt-auto">
                                <button class="w-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 py-4 rounded-xl font-black hover:bg-primary dark:hover:bg-primary dark:hover:text-white transition-all shadow-xl">
                                    Request to Join
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 p-6 rounded-2xl text-center">
                <p class="text-3xl font-black text-primary">@Model.ViewModel.TotalLiveMatches</p>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mt-1">Live Matches</p>
            </div>
            <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 p-6 rounded-2xl text-center">
                <p class="text-3xl font-black text-primary">@Model.ViewModel.TotalVenues</p>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mt-1">Court Venues</p>
            </div>
            <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 p-6 rounded-2xl text-center">
                <p class="text-3xl font-black text-primary">@Model.ViewModel.ActivePlayers+</p>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mt-1">Active Players</p>
            </div>
            <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 p-6 rounded-2xl text-center">
                <p class="text-3xl font-black text-primary">@Model.ViewModel.AverageRating.ToString("0.0")</p>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mt-1">Match Quality</p>
            </div>
        </div>
    </section>
</main>
