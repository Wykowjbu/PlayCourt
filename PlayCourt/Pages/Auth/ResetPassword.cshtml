@page
@model PlayCourt.Pages.Auth.ResetPasswordModel
@{
	Layout = "_AuthLayout";
	ViewData["Title"] = "Reset Password";
	ViewData["AuthTitle"] = "Reset Your<br /><span class='text-primary'>Password";
	ViewData["AuthDescription"] = "Enter your email to receive password reset instructions.";
}

<div class="flex flex-1 flex-col items-center justify-center bg-background-light dark:bg-background-dark px-6 py-12 lg:px-20 overflow-y-auto">
    <div class="w-full max-w-[480px]">
        <div class="flex items-center gap-2 mb-10 lg:hidden">
            <div class="flex items-center justify-center size-10 bg-primary rounded-xl text-black">
                <span class="material-symbols-outlined font-bold">sports_tennis</span>
            </div>
            <span class="text-2xl font-bold tracking-tight">PlayCourt</span>
        </div>

        <div class="mb-10">
            <h1 class="text-[#0d1b0f] dark:text-white tracking-tight text-4xl font-bold leading-tight mb-3">Reset Your Password</h1>
			<p class="text-gray-500 dark:text-gray-400 text-lg">Enter your new password below.</p>
        </div>

<div class="auth-card">
    <form method="post" class="space-y-5">

        <input type="hidden" asp-for="Input.Email" />
        <input type="hidden" asp-for="Input.Token" />

        <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold text-gray-700 dark:text-gray-300 ml-1">
                New Password
            </label>

            <input asp-for="Input.NewPassword"
                           id="new-password"
                   class="w-full h-14 rounded-2xl border border-gray-200
              dark:border-white/10 bg-white dark:bg-[#111c12]
              px-5 focus:border-primary focus:ring-4
              focus:ring-primary/10 outline-none transition-all
              placeholder:text-gray-400"
                   placeholder="Min. 8 characters" />

            <span asp-validation-for="Input.NewPassword"
                  class="text-xs text-red-500 ml-1"></span>
        </div>

        <div class="flex flex-col gap-1.5">
            <label class="text-sm font-semibold text-gray-700 dark:text-gray-300 ml-1">
                Confirm Password
            </label>

            <input asp-for="Input.ConfirmPassword"
                   class="w-full h-14 rounded-2xl border border-gray-200
              dark:border-white/10 bg-white dark:bg-[#111c12]
              px-5 focus:border-primary focus:ring-4
              focus:ring-primary/10 outline-none transition-all
              placeholder:text-gray-400"
                   placeholder="Confirm your password" />

            <span asp-validation-for="Input.ConfirmPassword"
                  class="text-xs text-red-500 ml-1"></span>
        </div>

                <div class="bg-slate-50 dark:bg-slate-800/50 rounded-xl p-4 space-y-2 mb-2">
                    <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                        Password Requirements
                    </p>

                    <div class="grid grid-cols-2 gap-x-2 gap-y-1">
                        <div class="flex items-center gap-1.5 text-[12px] text-slate-500">
                            <span id="req-length"
                                  class="material-symbols-outlined text-slate-300 text-[14px]">
                                circle
                            </span>
                            8+ characters
                        </div>

                        <div class="flex items-center gap-1.5 text-[12px] text-slate-500">
                            <span id="req-special"
                                  class="material-symbols-outlined text-slate-300 text-[14px]">
                                circle
                            </span>
                            1 special char
                        </div>

                        <div class="flex items-center gap-1.5 text-[12px] text-slate-500">
                            <span id="req-case"
                                  class="material-symbols-outlined text-slate-300 text-[14px]">
                                circle
                            </span>
                            Upper & lower
                        </div>

                        <div class="flex items-center gap-1.5 text-[12px] text-slate-500">
                            <span id="req-number"
                                  class="material-symbols-outlined text-slate-300 text-[14px]">
                                circle
                            </span>
                            1 number
                        </div>
                    </div>
                </div>



        <button class="w-full h-14 bg-primary text-black font-extrabold
               rounded-2xl shadow-xl shadow-primary/20
               hover:brightness-110 transition-all
               active:scale-[0.98]"
                type="submit">
            Update Password
        </button>

                <div class="pt-2 text-center">
                    <a class="text-sm font-bold text-slate-500 hover:text-primary transition-colors flex items-center justify-center gap-2 group" asp-page="/auth/forgptpassword">
                        <span class="material-symbols-outlined text-[18px] group-hover:-translate-x-1 transition-transform">arrow_back</span>
                        Back to Verification
                    </a>
                </div>

    </form>
</div>
</div>
</div>

@section Scripts {
<script>
const password = document.getElementById("new-password");

const lengthIcon = document.getElementById("req-length");
const specialIcon = document.getElementById("req-special");
const caseIcon = document.getElementById("req-case");
const numberIcon = document.getElementById("req-number");

function mark(icon, ok) {
    if (ok) {
        icon.textContent = "check_circle";
        icon.classList.remove("text-slate-300");
        icon.classList.add("text-primary");
    } else {
        icon.textContent = "circle";
        icon.classList.remove("text-primary");
        icon.classList.add("text-slate-300");
    }
}

password.addEventListener("input", function () {
    const value = password.value;

    const has8Chars = value.length >= 8;
    const hasNumber = /\d/.test(value);
    const hasSpecial = /[!@@#$%^&*(),.?":{}|<>]/.test(value);
    const hasUpperLower = /[a-z]/.test(value) && /[A-Z]/.test(value);

    mark(lengthIcon, has8Chars);
    mark(numberIcon, hasNumber);
    mark(specialIcon, hasSpecial);
    mark(caseIcon, hasUpperLower);
});
</script>
}
