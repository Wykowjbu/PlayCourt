@page
@model PlayCourt.Pages.Auth.ForgotPasswordModel
@{
	Layout = "_AuthLayout";
	ViewData["Title"] = "Forgot Password";
	ViewData["AuthTitle"] = "Forgot Your Password?<br /><span class='text-primary'>No Worries</span>";
	ViewData["AuthDescription"] = "Enter your email address below and we'll send you a link to reset your password.";
}


<div class="flex flex-1 flex-col items-center justify-center bg-background-light dark:bg-background-dark px-6 py-12 lg:px-20 overflow-y-auto">
    <div class="w-full max-w-[480px]">
        <div class="flex items-center gap-2 mb-10 lg:hidden">
            <div class="flex items-center justify-center size-10 bg-primary rounded-xl text-black">
                <span class="material-symbols-outlined font-bold">sports_tennis</span>
            </div>
            <span class="text-2xl font-bold tracking-tight">PlayCourt</span>
        </div>

        <div class="auth-card">
           
                    <div class="mb-8">
                        <h3 class="text-xl font-bold mb-1">Forgot Credentials?</h3>
                        <p class="text-slate-500 dark:text-slate-400 text-sm">
                            No worries, it happens to the best of us.
                        </p>
                    </div>

                    <form method="post" class="space-y-6">

                        <div class="space-y-2">
                            <label asp-for="Input.Email"
                                   class="text-sm font-bold text-slate-700 dark:text-slate-300 ml-1">
                                Email Address
                            </label>

                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-primary transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">mail</span>
                                </div>

                                <input asp-for="Input.Email"
                                       class="w-full h-14 rounded-2xl border border-gray-200 dark:border-white/10 bg-white dark:bg-[#111c12] pl-12 pr-5 focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none transition-all placeholder  dark:text-white"
                                       placeholder="name@example.com" />
                            </div>


                            <span asp-validation-for="Input.Email"
                                  class="text-red-500 text-xs font-semibold ml-1">
                            </span>
                        </div>

                        <button class="w-full py-4 bg-primary text-white font-bold rounded-xl shadow-lg shadow-primary/30 hover:bg-primary/90 hover:-translate-y-0.5 transition-all active:scale-[0.98] flex items-center justify-center gap-2"
                                type="submit">
                            <span>Send OTP Code</span>
                            <span class="material-symbols-outlined text-[20px]">password</span>
                        </button>

                        <div class="pt-4 text-center">
                            <a class="text-sm font-bold text-slate-500 hover:text-primary transition-colors flex items-center justify-center gap-2 group"
                               asp-page="/auth/register">
                                <span class="material-symbols-outlined text-[18px] group-hover:-translate-x-1 transition-transform">
                                    arrow_back
                                </span>
                                Back to Login
                            </a>
                        </div>

                    </form>
            
        </div>



    </div>
</div>
