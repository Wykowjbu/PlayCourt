@page "/register"
@model PlayCourt.Pages.Auth.RegisterModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Join the Community";
    ViewData["AuthTitle"] = "Join the Community<br /><span class='text-primary'>Start Playing</span>";
	ViewData["AuthDescription"] = "Create your PlayCourt account to start booking.";
}


    

    <div class="flex flex-1 flex-col items-center justify-center bg-background-light dark:bg-background-dark px-6 py-12 lg:px-20 overflow-y-auto">
        <div class="w-full max-w-[480px]">
            <div class="flex items-center gap-2 mb-10 lg:hidden">
                <div class="flex items-center justify-center size-10 bg-primary rounded-xl text-black">
                    <span class="material-symbols-outlined font-bold">sports_tennis</span>
                </div>
                <span class="text-2xl font-bold tracking-tight">PlayCourt</span>
            </div>

            <div class="mb-10">
                <h1 class="text-[#0d1b0f] dark:text-white tracking-tight text-4xl font-bold leading-tight mb-3">Join the Community</h1>
                <p class="text-gray-500 dark:text-gray-400 text-lg">Create your PlayCourt account to start booking.</p>
            </div>

            <form method="post" class="space-y-5">
                <div class="mb-8">
                    <div class="flex h-14 w-full items-center justify-center rounded-2xl bg-gray-100 dark:bg-white/5 p-1.5">
                        <label class="flex cursor-pointer h-full grow items-center justify-center overflow-hidden rounded-xl px-2 has-[:checked]:bg-white dark:has-[:checked]:bg-[#1a2e1d] has-[:checked]:shadow-sm has-[:checked]:text-[#0d1b0f] dark:has-[:checked]:text-primary text-gray-500 dark:text-gray-400 text-sm font-bold transition-all">
                            <span class="truncate flex items-center gap-2">
                                <span class="material-symbols-outlined text-xl">person</span> Player
                            </span>
                            <input asp-for="Input.Role" value="Player" class="invisible w-0" type="radio" checked onclick="goPlayer()" />
                        </label>
                        <label class="flex cursor-pointer h-full grow items-center justify-center overflow-hidden rounded-xl px-2 has-[:checked]:bg-white dark:has-[:checked]:bg-[#1a2e1d] has-[:checked]:shadow-sm has-[:checked]:text-[#0d1b0f] dark:has-[:checked]:text-primary text-gray-500 dark:text-gray-400 text-sm font-bold transition-all">
                            <span class="truncate flex items-center gap-2">
                                <span class="material-symbols-outlined text-xl">stadium</span> Court Owner
                            </span>
                            <input asp-for="Input.Role" value="CourtOwner" class="invisible w-0" type="radio" onclick="goOwner()" />
                        </label>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-5">
                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-semibold text-gray-700 dark:text-gray-300 ml-1">Full Name</label>
                        <input asp-for="Input.FullName" class="w-full h-14 rounded-2xl border border-gray-200 dark:border-white/10 bg-white dark:bg-[#111c12] px-5 focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none transition-all placeholder:text-gray-400" placeholder="Enter your name" />
                        <span asp-validation-for="Input.FullName" class="text-xs text-red-500 ml-1"></span>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-semibold text-gray-700 dark:text-gray-300 ml-1">Email Address</label>
                        <input asp-for="Input.Email" class="w-full h-14 rounded-2xl border border-gray-200 dark:border-white/10 bg-white dark:bg-[#111c12] px-5 focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none transition-all placeholder:text-gray-400" placeholder="name@email.com" />
                        <span asp-validation-for="Input.Email" class="text-xs text-red-500 ml-1"></span>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-semibold text-gray-700 dark:text-gray-300 ml-1">Phone Number</label>
                        <input asp-for="Input.PhoneNumber" class="w-full h-14 rounded-2xl border border-gray-200 dark:border-white/10 bg-white dark:bg-[#111c12] px-5 focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none transition-all placeholder:text-gray-400" placeholder="+84 XXX XXX XXX" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-xs text-red-500 ml-1"></span>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-semibold text-gray-700 dark:text-gray-300 ml-1">Password</label>
                        <div class="relative">
                            <input asp-for="Input.Password" class="w-full h-14 rounded-2xl border border-gray-200 dark:border-white/10 bg-white dark:bg-[#111c12] px-5 focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none transition-all placeholder:text-gray-400" placeholder="Min. 8 characters" />
                            <button type="button" class="absolute right-5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200" onclick="togglePassword()">
                                <span class="material-symbols-outlined" id="pw-icon">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-xs text-red-500 ml-1"></span>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-semibold text-gray-700 dark:text-gray-300 ml-1">Confirm Password</label>
                        <div class="relative">
                            <input asp-for="Input.ConfirmPassword" class="w-full h-14 rounded-2xl border border-gray-200 dark:border-white/10 bg-white dark:bg-[#111c12] px-5 focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none transition-all placeholder:text-gray-400" placeholder="Confirm Your Password" />
                            <button type="button" class="absolute right-5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200" onclick="togglePassword()">
                                <span class="material-symbols-outlined" id="pw-icon">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-xs text-red-500 ml-1"></span>
                    </div>
                </div>

                <button class="w-full h-14 bg-primary hover:brightness-110 text-black font-extrabold rounded-2xl shadow-xl shadow-primary/20 transition-all mt-8 active:scale-[0.98]" type="submit">
                    Create Account
                </button>
            </form>

            <p class="mt-10 text-center text-sm text-gray-500 dark:text-gray-400">
                Already part of PlayCourt?
                <a class="text-primary font-bold hover:underline ml-1" asp-page="./Login">Log In</a>
            </p>
        </div>
    </div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword() {
            const pwInput = document.getElementById('Input_Password');
            const pwIcon = document.getElementById('pw-icon');
            if (pwInput.type === 'password') {
                pwInput.type = 'text';
                pwIcon.innerText = 'visibility_off';
            } else {
                pwInput.type = 'password';
                pwIcon.innerText = 'visibility';
            }
        }

        function goOwner() {
            window.location.href = '/register-owner';
		}

        function goPlayer() {
			window.location.href = '/register';
		}
    </script>
}