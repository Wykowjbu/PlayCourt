@{
    Layout = "_Layout";
}

@section Styles {
    <style>
        /* Navigation active indicator */
        .nav-container {
            position: relative;
        }
        
        .nav-indicator {
            position: absolute;
            bottom: -1px;
            height: 3px;
            background-color: #22c55e;
            transition: all 0.3s ease;
            border-radius: 2px 2px 0 0;
        }
        
        .nav-link {
            position: relative;
            padding-bottom: 4px;
        }
    </style>
}

    <header class="sticky top-0 z-50 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 @ViewData["HeaderClass"]">
        <div class="max-w-[1440px] mx-auto px-6 @(ViewData["HeaderHeight"] ?? "h-18") flex items-center justify-between py-4">
            <div class="flex items-center gap-8">
                <div class="flex items-center gap-2">
                    <div class="bg-primary text-white p-1.5 rounded-lg flex items-center justify-center">
                        <span class="material-symbols-outlined text-2xl font-bold">sports_tennis</span>
                    </div>
                    <div class="flex flex-col">
                        <h2 class="text-xl font-black leading-none tracking-tight text-slate-900 dark:text-white">PlayCourt</h2>
                        <span class="text-[10px] font-bold text-primary uppercase tracking-widest">@(ViewData["BusinessTitle"] ?? "Business")</span>
                    </div>
                </div>
                
                @if (ViewData["ShowNavigation"] == null || (ViewData["ShowNavigation"] as bool? == true))
                {
                    <nav class="hidden md:flex items-center gap-8 border-l border-slate-200 dark:border-slate-700 pl-8 nav-container" id="mainNav">
                        <a class="nav-link text-sm font-bold text-slate-500 dark:text-slate-400 hover:text-primary transition-colors @(ViewData["ActiveNav"]?.Equals("Dashboard") == true ? "text-primary" : "")" href="/business/revenue" data-nav="dashboard">Dashboard</a>
                        <a class="nav-link text-sm font-bold text-slate-500 dark:text-slate-400 hover:text-primary transition-colors @(ViewData["ActiveNav"]?.Equals("Courts") == true ? "text-primary" : "")" href="/business/courts" data-nav="courts">Courts & Pricing</a>
                        <a class="nav-link text-sm font-bold text-slate-500 dark:text-slate-400 hover:text-primary transition-colors @(ViewData["ActiveNav"]?.Equals("Bookings") == true ? "text-primary" : "")" href="/business/schedule" data-nav="bookings">Schedule</a>
                        <div class="nav-indicator"></div>
                    </nav>
                }
                
                @if (ViewData["ShowDivider"] != null && (ViewData["ShowDivider"] as bool? == true))
                {
                    <div class="ml-4 pl-4 border-l border-slate-200 dark:border-slate-800">
                        <span class="text-xs font-black uppercase tracking-widest text-slate-400">@ViewData["DividerText"]</span>
                    </div>
                }
            </div>
            
            <div class="flex items-center gap-4">
                <div class="text-right mr-2 hidden sm:block">
                    <p class="text-sm font-bold text-slate-900 dark:text-white leading-none">@(ViewData["FacilityName"] ?? "Son Tra Arena")</p>
                    <p class="text-xs font-medium text-slate-500">@(ViewData["UserRole"] ?? "Facility Manager")</p>
                </div>
                <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10 border-2 border-primary" style='background-image: url("@(ViewData["UserAvatar"] ?? "https://lh3.googleusercontent.com/aida-public/AB6AXuABKesCcA8d2Wv4UJqezyaZFAo9B3zsNoUjeJPMb-eNlTHXgZT_h2U_wubpjxsUVjJP5qI25WVFXLk123TRQdSoFqS4pEs4qIl1BcvH0ZcMSGWParWyRVkoHJcL7fJ8vhNEMVyNBTbVN3Of7QLdGF7GwH1qDySrGsAVU51otLeOTB3sr6kZEWForfitNBHeguO6_jV1rX1iT6OHJF0MAnwSgVCjAZqigP4ALSCpJWJ9hbumtXT9JW9DiHQSXe_XK6DS-lGCY6BM9RTr");'></div>
            </div>
        </div>
    </header>

    @await RenderSectionAsync("ProgressSteps", required: false)

    <main class="max-w-[1440px] mx-auto px-6 py-10 @ViewData["MainClass"]">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Sidebar", required: false)

    @if (ViewData["ShowSupportButton"] == null || (ViewData["ShowSupportButton"] as bool? == true))
    {
        <div class="fixed bottom-8 right-8">
            <button class="flex items-center gap-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-6 py-4 rounded-2xl shadow-2xl hover:scale-105 active:scale-95 transition-all group">
                <span class="material-symbols-outlined text-primary group-hover:animate-bounce">help</span>
                <span class="text-sm font-black">Support Hub</span>
            </button>
        </div>
    }

    @if (ViewData["ShowFooter"] != null && (ViewData["ShowFooter"] as bool? == true))
    {
        <footer class="mt-20 py-10 border-t border-slate-200 dark:border-slate-800">
            <div class="max-w-[1440px] mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="flex items-center gap-2 grayscale opacity-50">
                    <span class="material-symbols-outlined text-xl">sports_tennis</span>
                    <span class="font-black text-xl tracking-tight">PlayCourt</span>
                </div>
                <p class="text-sm font-bold text-slate-400">© 2024 PlayCourt Technologies. All rights reserved.</p>
                <div class="flex gap-8">
                    <a class="text-sm font-bold text-slate-400 hover:text-primary transition-colors" href="#">Privacy</a>
                    <a class="text-sm font-bold text-slate-400 hover:text-primary transition-colors" href="#">Terms</a>
                    <a class="text-sm font-bold text-slate-400 hover:text-primary transition-colors" href="#">Support</a>
                </div>
            </div>
        </footer>
    }

   
    
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const nav = document.getElementById('mainNav');
            if (!nav) return;
            
            const links = nav.querySelectorAll('.nav-link');
            const indicator = nav.querySelector('.nav-indicator');
            
            if (!indicator || links.length === 0) return;
            
            // Find active link
            let activeLink = nav.querySelector('.nav-link.text-primary');
            if (!activeLink) activeLink = links[0];
            
            // Set initial position
            function updateIndicator(link) {
                const navRect = nav.getBoundingClientRect();
                const linkRect = link.getBoundingClientRect();
                indicator.style.width = linkRect.width + 'px';
                indicator.style.left = (linkRect.left - navRect.left) + 'px';
            }
            
            // Initial position
            updateIndicator(activeLink);
            
            // Hover effects
            links.forEach(link => {
                link.addEventListener('mouseenter', function() {
                    updateIndicator(this);
                });
            });
            
            // Reset to active on mouse leave
            nav.addEventListener('mouseleave', function() {
                updateIndicator(activeLink);
            });
            
            // Update on window resize
            window.addEventListener('resize', function() {
                updateIndicator(activeLink);
            });
        });
    </script>
