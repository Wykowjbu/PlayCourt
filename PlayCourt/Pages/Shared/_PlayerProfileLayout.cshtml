@{
    Layout = "_Layout";
}
   <div class="flex h-screen overflow-hidden">
        <aside class="w-72 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 flex flex-col h-full shadow-sm">
            <div class="p-6 flex flex-col gap-8 h-full">
                <div class="flex items-center gap-3">
                    <div class="bg-primary rounded-xl p-2.5 flex items-center justify-center shadow-lg shadow-primary/30">
                        <span class="material-symbols-outlined text-white text-2xl">sports_tennis</span>
                    </div>
                    <div>
                        <h1 class="text-xl font-extrabold tracking-tight text-slate-900 dark:text-white">PlayCourt</h1>
                        <p class="text-[10px] uppercase tracking-widest font-bold text-primary/80">Pro Management</p>
                    </div>
                </div>
                <nav class="flex flex-col gap-1.5 flex-grow">
                    <a class="flex items-center gap-3 px-4 py-3 rounded-xl bg-primary/10 text-primary font-bold transition-all" href="#">
                        <span class="material-symbols-outlined">person</span><span>General</span>
                    </a>
                    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" href="#">
                        <span class="material-symbols-outlined">shield</span><span>Security</span>
                    </a>
                    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" href="#">
                        <span class="material-symbols-outlined">calendar_today</span><span>My Bookings</span>
                    </a>
                    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors" href="#">
                        <span class="material-symbols-outlined">payments</span><span>Payments</span>
                    </a>
                </nav>
                <div class="pt-6 border-t border-slate-100 dark:border-slate-800">
                    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-red-500 hover:bg-red-50 dark:hover:bg-red-900/10 transition-colors font-medium" href="#">
                        <span class="material-symbols-outlined">logout</span><span>Sign Out</span>
                    </a>
                </div>
            </div>
        </aside>

        <main class="flex-1 overflow-y-auto">
            @RenderBody()
        </main>
    </div>
    @RenderSection("Scripts", required: false)