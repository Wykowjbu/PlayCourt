@{
    Layout = "_Layout";
}

@section Styles {
    <style>
        .step-active {
            border-color: #22c55e;
            background-color: #22c55e;
            color: white;
        }
        .step-done {
            border-color: #22c55e;
            color: #22c55e;
        }
        .step-pending {
            border-color: #e2e8f0;
            color: #cbd5e1;
        }
    </style>
}

<header class="sticky top-0 z-50 bg-white/80 dark:bg-background-dark/80 backdrop-blur-md border-b border-solid border-slate-200 dark:border-slate-800">
    <div class="max-w-[1440px] mx-auto px-6 h-20 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <div class="bg-primary text-white p-1.5 rounded-lg flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl font-bold">sports_tennis</span>
            </div>
            <h2 class="text-2xl font-black leading-none tracking-tight text-slate-900 dark:text-white">PlayCourt</h2>
            <div class="ml-4 pl-4 border-l border-slate-200 dark:border-slate-800">
                <span class="text-xs font-black uppercase tracking-widest text-slate-400">Business Center</span>
            </div>
        </div>
        <div class="flex items-center gap-4">
            <div class="text-right hidden sm:block">
                <p class="text-sm font-black text-slate-900 dark:text-white">Court Owner Hub</p>
                <p class="text-xs font-bold text-slate-400">support@playcourt.com</p>
            </div>
            <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10 border-2 border-primary" style='background-image: url("@(ViewData["UserAvatar"] ?? "https://lh3.googleusercontent.com/aida-public/AB6AXuDZlakN2MC51c9GaB_AFnycv7JLczn6ECUPKueHD2dEWwuGBtx-x9-cknVRP_ouECC7c4RAwFUSceY_cHIDsPSEQ6DaSWJmM3PJ9svepU55bMRTZCfppywAIbiQlVKztTqWqJjFfRqbrb59V8dRuJOoAkukuWMyyjhHv5dnQ1657MKHBB3rYNyIRseJX3hJu0lo2lvJ9E7BfySU58OP5LIk5sUPJ6A6vmR_p2-vv1VikyeTqhZ8B_GfU4AbAwA25hmc30f9CrO7vDGU");'></div>
        </div>
    </div>
</header>

<main class="max-w-[1440px] mx-auto px-6 py-12">
    <div class="flex flex-col lg:flex-row gap-12">
        <!-- Main Content -->
        <div class="flex-1">
            @RenderBody()
        </div>

        <!-- Sidebar -->
        <aside class="w-full lg:w-[380px] space-y-8">
            @await RenderSectionAsync("ProgressTracker", required: false)
            @await RenderSectionAsync("Tips", required: false)
        </aside>
    </div>
</main>

<footer class="mt-20 py-10 border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-[1440px] mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex items-center gap-2 grayscale opacity-50">
            <span class="material-symbols-outlined text-xl">sports_tennis</span>
            <span class="font-black text-xl tracking-tight">PlayCourt</span>
        </div>
        <p class="text-sm font-bold text-slate-400">© 2024 PlayCourt Technologies. All rights reserved.</p>
        <div class="flex gap-8">
            <a class="text-sm font-bold text-slate-400 hover:text-primary transition-colors" href="#">Privacy</a>
            <a class="text-sm font-bold text-slate-400 hover:text-primary transition-colors" href="#">Terms</a>
            <a class="text-sm font-bold text-slate-400 hover:text-primary transition-colors" href="#">Support</a>
        </div>
    </div>
</footer>

@await RenderSectionAsync("Scripts", required: false)

<script src="~/js/venue-registration.js"></script>

